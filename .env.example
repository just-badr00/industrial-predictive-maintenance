# MinIO address for programs running directly on the laptop.
# Compose overrides it with http://minio:9000 inside containers.
MINIO_ENDPOINT=http://localhost:9010

# MinIO administrator credentials.
MINIO_ROOT_USER=your-minio-admin-user
MINIO_ROOT_PASSWORD=your-minio-admin-password

# Credentials used by Python to access MinIO.
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key

# Existing bucket containing the project datasets and reports.
MINIO_BUCKET=your-project-bucket